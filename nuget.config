<configuration>
  <packageSources>
    <add key="adhoc" value="obj/adhoc-crypto" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="adhoc">
      <package pattern="AdHoc.Crypto" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
